# Supabase — publishable (anon) keys are safe to expose to the client.
# Copy this file to .env and fill in your project's values.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Server-only — required for Studio script server functions (NEVER commit the real value).
# Find it in Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server-only — Google Calendar feed for the Schedule agenda + Today digest.
# Use the "Secret address in iCal format" (Calendar Settings → Integrate calendar)
# so FULL event details come through even if public sharing is limited to free/busy.
# This is a credential — keep it server-side (no VITE_ prefix) and never commit it.
CALENDAR_ICS_URL="https://calendar.google.com/calendar/ical/info%40palmerhouseproductions.com/private-XXXXXXXX/basic.ics"
